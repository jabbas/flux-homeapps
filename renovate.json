{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Europe/Warsaw",
  "flux": { "fileMatch": ["\\.ya?ml$"] },
  "helmv3": { "fileMatch": ["/chart/Chart\\.ya?ml$"] },
  "packageRules": [
    { "matchManagers": ["flux", "helmv3"], "automerge": false },
    { "matchUpdateTypes": ["major"], "labels": ["dependencies", "major"] },
    { "matchUpdateTypes": ["minor", "patch"], "labels": ["dependencies"] }
  ]
}
